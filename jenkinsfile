pipeline {
  agent { label 'dotnet8' }
  options { timeout(time: 1, unit: 'HOURS') }
  triggers { pollSCM('* * * * *') }
  tools { dotnetsdk 'DOTNET10' }
  stages {
    stage("SCM") {
      steps {
        git url: 'https://github.com/duttarathi444/nopCommerce.git',
        branch: 'develop'
      }
    }
    stage("Build") {
      steps {
        sh 'dotnet build -c Release src/Presentation/Nop.Web/Nop.Web.csproj'
        sh 'mkdir published && dotnet publish -c Release -o published src/Presentation/Nop.Web/Nop.Web.csproj'
      }
      post {
        always {
          zip zipFile: './published.zip',
              archive : true,
              dir: './published'
              overwrite : true
        }
        cleanup {
          sh 'rm -rf published'
          sh 'rm -f published.zip'
        }
      }
    }
  }
}